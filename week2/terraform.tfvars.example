# Copy this file to terraform.tfvars and fill in your real values.
# Never commit terraform.tfvars itself if it contains sensitive data -
# add it to .gitignore.

tenancy_ocid       = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid          = "ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint        = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path   = "~/.oci/oci_api_key.pem"
region              = "me-jeddah-1"

compartment_id      = "ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

project_name        = "week2-lab"

vcn_cidr             = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

ssh_public_key_path = "~/.ssh/id_rsa.pub"

app_port            = 8080
lb_listener_port    = 80
